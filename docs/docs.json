{
  "theme": "mint",
  "name": "Wolffish",
  "seo": {
    "metatags": {
      "og:title": "Wolffish Documentation",
      "og:description": "A desktop agent with full access to your machine. Automate, create, and execute — entirely local. No cloud required.",
      "twitter:card": "summary",
      "twitter:title": "Wolffish Documentation"
    }
  },
  "colors": {
    "primary": "#1E40AF",
    "light": "#3B82F6",
    "dark": "#1E3A8A"
  },
  "logo": {
    "dark": "/static/icon.png",
    "light": "/static/icon.png"
  },
  "favicon": "/static/favicon.png",
  "css": "/static/custom.css",
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/younes-alturkey/wolffish"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://github.com/younes-alturkey/wolffish/releases/latest"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/younesbites",
      "reddit": "https://www.reddit.com/user/younesbites",
      "github": "https://github.com/younes-alturkey/wolffish"
    }
  },
  "redirects": [
    {
      "source": "/configuration/orchestrator-mode",
      "destination": "/configuration/workflow-mode",
      "permanent": true
    },
