{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "browser_specific_settings": {
    "gecko": {
      "id": "wolffish@wolffi.sh",
      "strict_min_version": "109.0"
    }
  },
  "version": "0.1.69",
  "description": "__MSG_extensionDescription__",
  "host_permissions": [
    "<all_urls>"
  ],
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "cookies",
    "downloads",
    "notifications",
    "clipboardRead",
    "clipboardWrite",
    "webNavigation",
    "sidePanel",
    "debugger",
    "identity",
    "identity.email"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "side_panel": {
    "default_path": "side-panel/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/all.iife.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon-16.png",
        "icon-32.png",
        "icon-48.png",
        "icon-128.png"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ]
}